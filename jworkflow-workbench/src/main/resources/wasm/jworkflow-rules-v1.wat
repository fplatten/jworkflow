(module
  (func (export "check") (param $rule i32) (param $value i32) (result i32)
    (if (result i32) (i32.eq (local.get $rule) (i32.const 1))
      (then (if (result i32) (i32.eqz (local.get $value)) (then (i32.const 1001)) (else (i32.const 0))))
      (else (if (result i32) (i32.eq (local.get $rule) (i32.const 2))
        (then (if (result i32) (i32.gt_s (local.get $value) (i32.const 500)) (then (i32.const 1002)) (else (i32.const 0))))
        (else (if (result i32) (i32.eq (local.get $rule) (i32.const 3))
          (then (if (result i32) (i32.gt_s (local.get $value) (i32.const 10)) (then (i32.const 1003)) (else (i32.const 0))))
          (else (i32.const 1099))))))))
)
